<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:BetterMail.App"
             xmlns:core="using:BetterMail.Core"
             x:Class="BetterMail.App.ConversationThreadView">
  <UserControl.Resources><app:MailActionFeedbackConverter x:Key="MailActionFeedback" /></UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.threadHeader"><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Border.threadHeader:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource BetterMailAccentBrush}" /></Style>
    <Style Selector="Border.threadMessage">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BetterMailDividerBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.threadMessage.selected">
      <Setter Property="Background" Value="{DynamicResource BetterMailSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BetterMailAccentBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
    <Border Padding="22,18"
            BorderBrush="{DynamicResource BetterMailDividerBrush}"
            BorderThickness="0,0,0,1">
      <Grid x:Name="ThreadHeaderLayout">
        <StackPanel x:Name="ThreadHeading">
          <SelectableTextBlock Text="{Binding SelectedThread.Subject, FallbackValue=Select a conversation}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               MaxLines="2" />
          <TextBlock Text="{Binding ThreadItemCountText}"
                     FontSize="11"
                     Opacity="0.62" />
        </StackPanel>

      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="8,5" BorderBrush="{DynamicResource BetterMailDividerBrush}"
            BorderThickness="0,0,0,1" IsVisible="{Binding ShowActions}">
      <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="command" Content="Reply all" Command="{Binding ReplyAllCommand}" />
            <Button Classes="command" Content="Reply" Command="{Binding ReplyCommand}" />
            <Button Classes="command" Content="Forward" Command="{Binding ForwardCommand}" />
            <Button Classes="command" Content="Archive" Command="{Binding ArchiveCommand}" />
            <Button Classes="command" Content="Delete" Command="{Binding DeleteCommand}" />
            <Button Classes="command" Content="Move" Click="MoveClicked" />
            <Button Classes="command" Content="More">
              <Button.Flyout>
                <Flyout>
                  <StackPanel MinWidth="190">
                    <Button Classes="command" Content="Junk" HorizontalContentAlignment="Left" Command="{Binding JunkCommand}" />
                    <Button Classes="command" Content="Not junk" HorizontalContentAlignment="Left" Command="{Binding NotJunkCommand}" />
                    <Button Classes="command" Content="{Binding ToggleFlagText}" HorizontalContentAlignment="Left" Command="{Binding ToggleFlagCommand}" />
                    <Button Classes="command" Content="{Binding TogglePinText}" HorizontalContentAlignment="Left" Command="{Binding TogglePinCommand}" />
                    <Button Classes="command" Content="{Binding ToggleReadText}" HorizontalContentAlignment="Left" Command="{Binding ToggleReadCommand}" />
                    <Button Classes="command" Content="View headers" HorizontalContentAlignment="Left" Command="{Binding ViewHeadersCommand}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Border>

    <Border Grid.Row="3" Padding="12,7" Background="#0A0F6CBD"
            BorderBrush="{DynamicResource BetterMailDividerBrush}" BorderThickness="0,0,0,1"
            IsVisible="{Binding ShowAttachmentArea}">
      <StackPanel Spacing="5">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding AttachmentSummary}" FontSize="11" FontWeight="SemiBold"
                     IsVisible="{Binding !IsLoadingAttachments}" />
          <Button Grid.Column="1" Classes="command" Content="Save all"
                  Command="{Binding SaveAttachmentsCommand}" IsVisible="{Binding CanSaveAttachments}"
                  AutomationProperties.Name="Save all attachments to a folder" />
        </Grid>
        <ProgressBar Width="90" Height="3" IsIndeterminate="True" HorizontalAlignment="Left"
                     IsVisible="{Binding IsLoadingAttachments}" />
        <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding !IsLoadingAttachments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:MailAttachment">
              <Button Classes="command" Padding="8,5" Margin="0,0,6,2"
                      Command="{Binding $parent[UserControl].DataContext.OpenAttachmentCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="Preview attachment"
                      AutomationProperties.Name="{Binding Name, StringFormat='Preview attachment {0}'}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="&#x1F4CE;" FontFamily="Segoe UI Symbol" Opacity="0.65" />
                  <TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <ScrollViewer x:Name="ThreadHeaderScroll" Grid.Row="2"
                  MaxHeight="184"
                  IsVisible="{Binding ShowThreadList}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="Conversation message headers">
      <StackPanel>
        <ItemsControl x:Name="ThreadMessages"
                    ItemsSource="{Binding SelectedThread.Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="app:ConversationMessageItem">
            <Border Classes="threadMessage"
                    Classes.selected="{Binding IsSelected}">
              <Grid>
                <Border Classes="threadHeader" Padding="12,8" Tapped="ThreadHeaderTapped" Focusable="True" KeyDown="ThreadHeaderKeyDown" AutomationProperties.Name="{Binding Sender, StringFormat='Open message from {0}'}">
                  <Grid ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                      <app:AsyncImage Grid.Column="0" VerticalAlignment="Top" Width="24" Height="24" EmailAddress="{Binding SenderAddress}" IsHitTestVisible="False"
                                      IsVisible="{Binding $parent[UserControl].ShowSenderImages}"
                                      AllowLoading="{Binding $parent[UserControl].ShowSenderImages}" />
                      <StackPanel Grid.Column="1" Spacing="3">
                      <SelectableTextBlock Text="{Binding Sender}"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                      <SelectableTextBlock Text="{Binding SenderAddress}"
                                 FontSize="11"
                                 Opacity="0.58"
                                 TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                    <SelectableTextBlock Grid.Column="1"
                               Text="{Binding ReceivedText}"
                               FontSize="11"
                               Opacity="0.62"
                               TextWrapping="Wrap" />
                    <SelectableTextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding Recipients}"
                               FontSize="11"
                               Opacity="0.62"
                               TextWrapping="Wrap" />
                    <SelectableTextBlock Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Text="{Binding Location}"
                               FontSize="11"
                               Foreground="{DynamicResource BetterMailAccentBrush}"
                               TextWrapping="Wrap" />
                    <ProgressBar Grid.ColumnSpan="2" Height="2" IsIndeterminate="True" VerticalAlignment="Bottom" IsHitTestVisible="False">
                  <ProgressBar.IsVisible><MultiBinding Converter="{StaticResource MailActionFeedback}">
                    <Binding /><ReflectionBinding Path="FeedbackOwner" RelativeSource="{RelativeSource AncestorType={x:Type app:ConversationThreadView}}" /><ReflectionBinding Path="FeedbackOwner.MailActionVersion" RelativeSource="{RelativeSource AncestorType={x:Type app:ConversationThreadView}}" />
                  </MultiBinding></ProgressBar.IsVisible>
                </ProgressBar>
              </Grid>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
        <ItemsControl ItemsSource="{Binding Drafts}"
                      IsVisible="{Binding HasDrafts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:LocalDraft">
              <Button Classes="command"
                      Padding="12,9"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Command="{Binding $parent[UserControl].DataContext.OpenDraftCommand}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding DisplaySubject, StringFormat='Continue draft {0}'}">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="9">
                  <Border Background="#FFF4CC" CornerRadius="3" Padding="6,2">
                    <TextBlock Text="Draft" Foreground="#8A5A00" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding DisplaySubject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding LocalUpdatedAt, StringFormat='{}{0:g}'}" FontSize="11" Opacity="0.62" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding To, StringFormat='To: {0}'}" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="4"
          RowDefinitions="Auto,*"
          IsVisible="{Binding HasThread}">
      <Border Padding="10,5"
              Background="#0A0F6CBD"
              BorderBrush="{DynamicResource BetterMailDividerBrush}"
              BorderThickness="0,0,0,1"
              IsVisible="{Binding SelectedMessage.HasBlockedRemoteContent}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="Some pictures were blocked to protect your privacy."
                     FontSize="11"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="1"
                  Classes="command"
                  Content="Load pictures"
                  Command="{Binding AllowRemoteContentCommand}"
                  CommandParameter="{Binding SelectedMessage}"
                  AutomationProperties.Name="Load blocked pictures for the selected message"
                  AutomationProperties.HelpText="Downloads external images for only this message"
                  Padding="7,2" />
        </Grid>
      </Border>

      <NativeWebView Grid.Row="1"
                     x:Name="MessageWebView"
                     NavigationStarted="MessageWebView_NavigationStarted"
                     AutomationProperties.Name="Selected conversation message content" />
    </Grid>

    <StackPanel Grid.Row="3"
                Grid.RowSpan="2"
                IsVisible="{Binding HasNoThread}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6">
      <TextBlock Text="No conversation selected" FontSize="17" Opacity="0.62" />
      <TextBlock Text="Select a message to read its thread." Opacity="0.52" />
    </StackPanel>
  </Grid>
</UserControl>
