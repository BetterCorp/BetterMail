<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:BetterMail.Core"
        xmlns:app="using:BetterMail.App"
        x:Class="BetterMail.App.MainWindow"
        Title="BetterMail"
        Icon="/Assets/BetterMail.ico"
        Width="1420"
        Height="900"
        MinWidth="320"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <app:AppInfo x:Key="AppInfo" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource BetterMailAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.settingsCard">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BetterMailDividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18" />
    </Style>
  </Window.Styles>
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding ComposeCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding ReplyCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding ReplyAllCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ForwardCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding FocusSearchCommand}" />
    <KeyBinding Gesture="F9" Command="{Binding SyncCommand}" />
  </Window.KeyBindings>

  <Grid x:Name="ShellGrid" RowDefinitions="56,46,*,0" ColumnDefinitions="72,248,380,*">
    <!-- Workspace header -->
    <Border Grid.ColumnSpan="4" Background="{DynamicResource BetterMailHeaderBrush}">
      <Grid x:Name="HeaderLayout" ColumnDefinitions="230,*,Auto" Margin="10,0,10,0">
        <StackPanel x:Name="HeaderBrand" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Image Source="/Assets/BetterMail.png" Width="24" Height="24" />
          <TextBlock Text="BetterMail" Foreground="{DynamicResource BetterMailTextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <Grid x:Name="HeaderSearch" Grid.Column="1" MaxWidth="620" HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto">
          <TextBox x:Name="MailSearch" Classes="search"
                   PlaceholderText="Search everything"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   Padding="12,6,36,6"
                   KeyDown="GlobalSearchKeyDown"
                   AutomationProperties.Name="Search everything"
                   AutomationProperties.HelpText="Search mail, people, calendar, tasks, drives, and notes across linked accounts"
                   TabIndex="0"
                   VerticalAlignment="Center" />
          <Button Grid.Column="0"
                  Content="&#x2715;"
                  Command="{Binding ClearGlobalSearchCommand}"
                  IsVisible="{Binding HasSearchText}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Width="30"
                  Height="30"
                  Margin="0,0,3,0"
                  Padding="0"
                  Background="Transparent"
                  Foreground="{DynamicResource BetterMailSearchForegroundBrush}"
                  AutomationProperties.Name="Clear search" />
          <Button Grid.Column="1"
                  Content="Search"
                  Command="{Binding SearchCommand}"
                  Background="Transparent"
                  Foreground="{DynamicResource BetterMailTextBrush}"
                  Padding="10,5"
                  AutomationProperties.Name="Run mail search"
                  TabIndex="1"
                  VerticalAlignment="Center" />
          <Popup x:Name="GlobalSearchPopup"
                 Grid.ColumnSpan="2"
                 IsOpen="{Binding IsGlobalSearchOpen, Mode=TwoWay}"
                 PlacementTarget="{Binding #MailSearch}"
                 Placement="BottomEdgeAlignedLeft"
                 IsLightDismissEnabled="True">
            <Border x:Name="GlobalSearchResultsPanel"
                    Width="900"
                    MaxHeight="720"
                    Background="{DynamicResource BetterMailSurfaceBrush}"
                    BorderBrush="{DynamicResource BetterMailDividerBrush}"
                    BorderThickness="1"
                    BoxShadow="0 8 24 0 #44000000"
                    Padding="0">
              <Grid RowDefinitions="Auto,Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="16,12,8,9">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Search results" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SearchText, StringFormat='Across all accounts for “{0}”'}" FontSize="11" Opacity="0.62" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="62" Height="3" IsVisible="{Binding IsGlobalSearchRunning}" />
                    <Button Classes="command" Content="×" Command="{Binding CloseGlobalSearchCommand}" AutomationProperties.Name="Close search results" />
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="8" Margin="16,0,12,8">
                  <ComboBox Width="132" ItemsSource="{Binding SearchScopes}" SelectedItem="{Binding SelectedSearchScope}" AutomationProperties.Name="Search scope" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding SearchAccountFilters}" SelectedItem="{Binding SelectedSearchAccountFilter}" AutomationProperties.Name="Search account">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="app:SearchAccountFilter"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox Grid.Column="2" ItemsSource="{Binding SearchFolderFilters}" SelectedItem="{Binding SelectedSearchFolderFilter}" IsVisible="{Binding ShowSearchFolderFilter}" AutomationProperties.Name="Search mail folder">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="app:SearchFolderFilter"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox Grid.Column="3"
                            Content="Include archives"
                            IsChecked="{Binding IncludeArchivedMailInSearch}"
                            IsVisible="{Binding ShowMailSearchOptions}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Include archived mail in search" />
                </Grid>
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding GlobalSearchResults}"
                         MaxHeight="640"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="Results from all BetterMail modules">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                      <Setter Property="Background" Value="Transparent" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="app:GlobalSearchResult" x:CompileBindings="True">
                      <StackPanel>
                        <TextBlock Text="{Binding Category}"
                                   IsVisible="{Binding StartsCategory}"
                                   Margin="16,10,12,4"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.64" />
                        <Grid IsVisible="{Binding StartsAccountGroup}"
                              Margin="18,7,12,3"
                              ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding AccountGroup}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource BetterMailAccentBrush}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <Button Grid.Column="1"
                                  Classes="command"
                                  Padding="5,2"
                                  MinHeight="0"
                                  Command="{ReflectionBinding $parent[Window].DataContext.OpenGlobalSearchGroupCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Category, StringFormat='View {0} results for this account'}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="{Binding Glyph}" FontSize="11" />
                              <TextBlock Text="{Binding Category, StringFormat='View {0}'}" FontSize="11" />
                            </StackPanel>
                          </Button>
                        </Grid>
                        <Button Classes="searchResult"
                                HorizontalContentAlignment="Stretch"
                                Command="{ReflectionBinding $parent[Window].DataContext.OpenGlobalSearchResultCommand}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Title}">
                          <Grid>
                          <Grid IsVisible="{Binding IsNotMail}" ColumnDefinitions="34,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                            <Border Width="30" Height="30" CornerRadius="3" Background="{DynamicResource BetterMailSelectionBrush}" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Glyph}" Foreground="{DynamicResource BetterMailAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Subtitle}" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                          </Grid>
                          <Grid IsVisible="{Binding IsMail}" ColumnDefinitions="4,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                            <Border Grid.RowSpan="4" Background="{Binding MailboxColor}" CornerRadius="2" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding MailWhen}" FontSize="11" Opacity="0.68" />
                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                              <TextBlock Text="{Binding MailFrom}" FontSize="11" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Text="{Binding MailTo}" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Border Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Background="{DynamicResource BetterMailSelectionBrush}" Padding="6,2" CornerRadius="3">
                              <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{DynamicResource BetterMailAccentBrush}" />
                            </Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                          </Grid>
                          </Grid>
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Popup>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button x:Name="SyncStatusButton" Content="{Binding SyncIcon}" Click="SyncStatusClicked" Background="Transparent"
                  Foreground="{DynamicResource BetterMailTextBrush}" FontSize="17" ToolTip.Tip="Sync status (F9 to sync)"
                  AutomationProperties.Name="Sync mail and view progress" TabIndex="2">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="360" Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Sync activity" FontSize="17" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Classes="command" Content="Sync now" Command="{Binding SyncCommand}" />
                  </Grid>
                  <StackPanel DataContext="{Binding WorkspaceSyncStep}" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource BetterMailMutedBrush}" />
                    <ProgressBar IsVisible="{Binding Running}" IsIndeterminate="True" Height="3" />
                  </StackPanel>
                  <StackPanel DataContext="{Binding StorageSyncStep}" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource BetterMailMutedBrush}" />
                    <ProgressBar IsVisible="{Binding Running}" IsIndeterminate="True" Height="3" />
                  </StackPanel>
                  <ScrollViewer MaxHeight="440">
                    <ItemsControl ItemsSource="{Binding SyncSteps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Spacing="4" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource BetterMailMutedBrush}" TextWrapping="Wrap" />
                            <ProgressBar IsVisible="{Binding Running}" IsIndeterminate="{Binding Indeterminate}" Value="{Binding Progress}" Height="3" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Compact application rail -->
    <Border x:Name="AppRail" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
            Background="{DynamicResource BetterMailSidebarBrush}"
            BorderBrush="{DynamicResource BetterMailDividerBrush}"
            BorderThickness="0,0,1,0">
      <Grid x:Name="AppRailLayout" RowDefinitions="Auto,*,Auto" Margin="3,5">
        <StackPanel x:Name="RailModules" Spacing="3">
          <Button Classes="rail" Classes.selected="{Binding IsMailModule}" Command="{Binding ShowUnifiedInboxCommand}" ToolTip.Tip="Mail" Click="MailModuleClicked" AutomationProperties.Name="Mail" TabIndex="10"><StackPanel Spacing="2"><Path Data="M2,4 H22 V20 H2 Z M2,5 L12,13 L22,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="moduleLabel" Text="Mail" /></StackPanel></Button>
          <Button Classes="rail" Classes.selected="{Binding IsCalendarModule}" Command="{Binding ShowCalendarCommand}" ToolTip.Tip="Calendar" AutomationProperties.Name="Calendar" AutomationProperties.HelpText="Requires a connected Microsoft 365 account" TabIndex="11"><StackPanel Spacing="2"><Path Data="M3,5 H21 V21 H3 Z M3,10 H21 M7,2 V7 M17,2 V7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="moduleLabel" Text="Calendar" /></StackPanel></Button>
          <Button Classes="rail" Classes.selected="{Binding IsContactsModule}" Command="{Binding ShowContactsCommand}" ToolTip.Tip="People" AutomationProperties.Name="People" AutomationProperties.HelpText="Requires a connected Microsoft 365 account" TabIndex="12"><StackPanel Spacing="2"><Path Data="M8,8 A4,4 0 1 0 16,8 A4,4 0 1 0 8,8 M4,22 V19 C4,12 20,12 20,19 V22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="moduleLabel" Text="People" /></StackPanel></Button>
          <Button Classes="rail" Classes.selected="{Binding IsTasksModule}" Command="{Binding ShowTasksCommand}" ToolTip.Tip="To Do" AutomationProperties.Name="To Do" AutomationProperties.HelpText="Requires a connected Microsoft 365 account" TabIndex="13"><StackPanel Spacing="2"><Path Data="M4,12 L9,17 L20,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="moduleLabel" Text="To Do" /></StackPanel></Button>
          <Button Classes="rail" Classes.selected="{Binding IsFilesModule}" Command="{Binding ShowFilesCommand}" ToolTip.Tip="Files — Drive" AutomationProperties.Name="Files" AutomationProperties.HelpText="Requires a connected Microsoft 365 account" TabIndex="14"><StackPanel Spacing="2"><Path Data="M2,6 H10 L12,9 H22 V21 H2 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="moduleLabel" Text="Files" /></StackPanel></Button>
          <Button Classes="rail" Classes.selected="{Binding IsNotesModule}" Command="{Binding ShowNotesCommand}" ToolTip.Tip="Notes" AutomationProperties.Name="Notes" AutomationProperties.HelpText="Requires a connected Microsoft 365 account" TabIndex="15"><StackPanel Spacing="2"><Path Data="M5,2 H19 V22 H5 Z M8,7 H16 M8,12 H16 M8,17 H14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="moduleLabel" Text="Notes" /></StackPanel></Button>
        </StackPanel>
        <Button x:Name="RailSettings" Grid.Row="2" Classes="rail" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings" TabIndex="16"><StackPanel Spacing="2"><Path Data="M12,3 L15,5 L19,5 L19,9 L21,12 L19,15 L19,19 L15,19 L12,21 L9,19 L5,19 L5,15 L3,12 L5,9 L5,5 L9,5 Z M8,12 A4,4 0 1 0 16,12 A4,4 0 1 0 8,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="moduleLabel" Text="Settings" /></StackPanel></Button>
      </Grid>
    </Border>

    <!-- Mail command bar: only actions currently supported by BetterMail -->
    <Border x:Name="MailCommandBar" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
            Background="{DynamicResource BetterMailSurfaceBrush}"
            BorderBrush="{DynamicResource BetterMailDividerBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding ShowMailSurface}"
            Padding="0">
      <Grid ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0" Margin="8,6" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="3" IsVisible="{Binding !IsMailActionRunning}">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <Button x:Name="FolderToggle" Classes="command" Content="☰ Folders" Click="FolderToggleClicked" IsVisible="False" AutomationProperties.Name="Show folders" />
            <Button Classes="primary" Content="＋ New mail" Command="{Binding ComposeCommand}" AutomationProperties.Name="New mail" />
          </StackPanel>
          <Border Grid.Column="1" Width="1" Height="24" Background="{DynamicResource BetterMailDividerBrush}" Margin="6,3" />
          <StackPanel x:Name="InlineMailActions" Grid.Column="2" Orientation="Horizontal" Spacing="3">
            <Button Classes="command" Content="Reply all" Command="{Binding ReplyAllCommand}" AutomationProperties.Name="Reply all to selected message" />
            <Button Classes="command" Content="↩ Reply" Command="{Binding ReplyCommand}" AutomationProperties.Name="Reply to selected message" />
            <Button Classes="command" Content="↪ Forward" Command="{Binding ForwardCommand}" AutomationProperties.Name="Forward selected message" />
            <Button Classes="command" Content="Archive" Command="{Binding ArchiveCommand}" AutomationProperties.Name="Archive selected message" AutomationProperties.HelpText="Keyboard shortcut Backspace" />
            <Button Classes="command" Content="Delete" Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete selected message" />
            <Button Classes="command" Content="Move" AutomationProperties.Name="Move selected messages">
              <Button.Flyout>
                <Flyout><ScrollViewer MaxHeight="420" MinWidth="230"><ItemsControl ItemsSource="{Binding Folders}"><ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:MailFolderItem"><Button Classes="command" Content="{Binding DisplayName}" HorizontalContentAlignment="Left" Command="{Binding $parent[Window].DataContext.MoveToFolderCommand}" CommandParameter="{Binding}" /></DataTemplate>
                </ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <Button Grid.Column="3"
                  Classes="command"
                  Content="More ⌄"
                  AutomationProperties.Name="More mail actions"
                  ToolTip.Tip="More mail actions">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel MinWidth="190">
                  <Button Classes="command" Content="Reply all" HorizontalContentAlignment="Left" Click="MessageReplyAllClicked" AutomationProperties.Name="Reply all to selected message" />
                  <Button Classes="command" Content="Reply" HorizontalContentAlignment="Left" Click="MessageReplyClicked" AutomationProperties.Name="Reply to selected message" />
                  <Button Classes="command" Content="Forward" HorizontalContentAlignment="Left" Click="MessageForwardClicked" AutomationProperties.Name="Forward selected message" />
                  <Button Classes="command" Content="Archive" HorizontalContentAlignment="Left" Click="MessageArchiveClicked" AutomationProperties.Name="Archive selected message" AutomationProperties.HelpText="Keyboard shortcut Backspace" />
                  <Button Classes="command" Content="Delete" HorizontalContentAlignment="Left" Click="MessageDeleteClicked" AutomationProperties.Name="Delete selected message" />
                  <Button Classes="command" Content="Move to folder" HorizontalContentAlignment="Left">
                    <Button.Flyout>
                      <Flyout><ScrollViewer MaxHeight="420" MinWidth="230"><ItemsControl ItemsSource="{Binding Folders}"><ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:MailFolderItem"><Button Classes="command" Content="{Binding DisplayName}" HorizontalContentAlignment="Left" Command="{Binding $parent[Window].DataContext.MoveToFolderCommand}" CommandParameter="{Binding}" /></DataTemplate>
                      </ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Flyout>
                    </Button.Flyout>
                  </Button>
                  <Border Height="1" Background="{DynamicResource BetterMailDividerBrush}" Margin="4" />
                  <Button Classes="command" Content="Junk" HorizontalContentAlignment="Left" Click="MessageJunkClicked" AutomationProperties.Name="Mark selected message as junk" />
                  <Button Classes="command" Content="{Binding ToggleFlagText}" HorizontalContentAlignment="Left" Click="MessageFlagClicked" AutomationProperties.Name="{Binding ToggleFlagText}" />
                  <Button Classes="command" Content="{Binding TogglePinText}" HorizontalContentAlignment="Left" Command="{Binding TogglePinCommand}" AutomationProperties.Name="{Binding TogglePinText}" />
                  <Button Classes="command" Content="{Binding ToggleReadText}" HorizontalContentAlignment="Left" Click="MessageReadClicked" AutomationProperties.Name="{Binding ToggleReadText}" />
                  <Button Classes="command" Content="View headers" HorizontalContentAlignment="Left" Command="{Binding ViewHeadersCommand}" AutomationProperties.Name="View internet message headers" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <StackPanel Grid.Column="0"
                    Margin="8,6"
                    IsVisible="{Binding IsMailActionRunning}"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <ProgressBar Width="96" Height="3" IsIndeterminate="True" VerticalAlignment="Center" />
          <TextBlock Text="{Binding MailActionStatus}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="command"
                Width="200"
                Margin="0"
                Padding="0"
                CornerRadius="0"
                HorizontalContentAlignment="Stretch"
                IsVisible="{Binding HasNextCalendarEvent}"
                Command="{Binding OpenNextCalendarEventCommand}"
                AutomationProperties.Name="{Binding NextCalendarEventSubject, StringFormat='Open next event: {0}'}">
          <Grid ColumnDefinitions="3,*,Auto">
            <Border Background="{Binding NextCalendarEventColor}" />
            <TextBlock Grid.Column="1"
                       Margin="9,0,6,0"
                       Text="{Binding NextCalendarEventSubject}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2"
                       Margin="3,0,9,0"
                       Text="{Binding NextCalendarEventTime}"
                       Opacity="0.72"
                       VerticalAlignment="Center" />
          </Grid>
        </Button>
      </Grid>
    </Border>

    <!-- Structured folder pane -->
    <Border x:Name="FolderPane" Grid.Row="2" Grid.Column="1"
            Background="{DynamicResource BetterMailSidebarBrush}"
            BorderBrush="{DynamicResource BetterMailDividerBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Text="Mail" FontSize="20" FontWeight="SemiBold" Margin="16,14,12,10" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10,0,10,12" Spacing="2">
            <TextBlock Text="FAVORITES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BetterMailMutedBrush}" Margin="4,8,4,3" />
            <Button Classes="folder" Classes.selected="{Binding IsUnifiedInbox}" Command="{Binding ShowUnifiedInboxCommand}" Click="FolderSelectedClicked"
                    AutomationProperties.Name="Unified Inbox" TabIndex="40">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Unified Inbox" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding UnifiedMessageCountText}" FontWeight="SemiBold" Foreground="{DynamicResource BetterMailAccentBrush}" Margin="6,0,1,0" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="folder" Classes.selected="{Binding IsPinnedView}" Command="{Binding ShowPinnedCommand}"
                    Click="FolderSelectedClicked" AutomationProperties.Name="Pinned messages">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Pinned" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PinnedMessageCountText}" FontWeight="SemiBold" Foreground="{DynamicResource BetterMailAccentBrush}" Margin="6,0,1,0" />
              </Grid>
            </Button>
            <Button Classes="folder" Classes.selected="{Binding IsFlaggedView}" Command="{Binding ShowFlaggedCommand}"
                    Click="FolderSelectedClicked" AutomationProperties.Name="Flagged messages">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Flagged" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding FlaggedMessageCountText}" FontWeight="SemiBold" Foreground="{DynamicResource BetterMailAccentBrush}" Margin="6,0,1,0" />
              </Grid>
            </Button>
            <Button Classes="folder" Classes.selected="{Binding IsAllDraftsView}"
                    Command="{Binding ShowDraftsCommand}"
                    Click="FolderSelectedClicked"
                    AutomationProperties.Name="Open Drafts">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Drafts" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Drafts.Count}" FontWeight="SemiBold" Foreground="{DynamicResource BetterMailAccentBrush}" Margin="6,0,1,0" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="folder" Classes.selected="{Binding IsOutboxView}"
                    Command="{Binding ShowOutboxCommand}" Click="FolderSelectedClicked" IsVisible="{Binding HasOutbox}"
                    AutomationProperties.Name="Open Busy">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Busy" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding OutboxCountText}" FontWeight="SemiBold"
                           Foreground="{DynamicResource BetterMailAccentBrush}" Margin="6,0,1,0" />
              </Grid>
            </Button>
            <Expander Margin="0,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Expander.Header>
                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                  <TextBlock Text="Sync issues" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding SyncIssueCountText}" FontWeight="SemiBold" Foreground="#D13438" Margin="6,0,1,0" />
                </Grid>
              </Expander.Header>
              <StackPanel Margin="18,2,0,3">
                <Button Classes="folder" Classes.selected="{Binding IsSyncIssuesView}" Command="{Binding ShowSyncIssuesCommand}" Click="FolderSelectedClicked">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="All issues" />
                    <TextBlock Grid.Column="1" Text="{Binding SyncIssueCountText}" Foreground="#D13438" />
                  </Grid>
                </Button>
                <Button Classes="folder" Classes.selected="{Binding IsDraftConflictsView}" Command="{Binding ShowDraftConflictsCommand}" Click="FolderSelectedClicked">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Conflicts" />
                    <TextBlock Grid.Column="1" Text="{Binding DraftConflictCountText}" Foreground="#D13438" />
                  </Grid>
                </Button>
              </StackPanel>
            </Expander>

            <TextBlock Text="ACCOUNTS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BetterMailMutedBrush}" Margin="4,12,4,3" />
            <ItemsControl ItemsSource="{Binding FolderGroups}" HorizontalAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:MailboxFolderGroup">
                  <Expander Classes="accountSection" IsExpanded="True" Margin="0,4" Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding DisplayName}">
                    <Expander.Header>
                      <Grid RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="{Binding Address}" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis" />

                      </Grid>
                    </Expander.Header>
                    <TreeView ItemsSource="{Binding Folders}" Margin="0,2,0,4"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{Binding DisplayName, StringFormat='Folders for {0}'}"
                              AutomationProperties.HelpText="Use arrow keys to expand or collapse nested folders">
                      <TreeView.Styles>
                        <Style Selector="Button.folder:pointerover /template/ ContentPresenter">
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="BorderBrush" Value="Transparent" />
                          <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style Selector="TreeViewItem:pointerover /template/ ContentPresenter">
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="BorderBrush" Value="Transparent" />
                          <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style Selector="TreeViewItem:selected /template/ ContentPresenter">
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="BorderBrush" Value="Transparent" />
                          <Setter Property="BorderThickness" Value="0" />
                        </Style>
                      </TreeView.Styles>
                      <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="app:MailFolderNode" ItemsSource="{Binding Children}">
                          <Button Classes="folder" Classes.selected="{Binding Item.IsSelected}"
                                  Command="{Binding $parent[Window].DataContext.SelectFolderCommand}"
                                  CommandParameter="{Binding Item}"
                                  Click="FolderSelectedClicked"
                                  DragDrop.AllowDrop="True"
                                  DragDrop.DragOver="FolderDragOver"
                                  DragDrop.Drop="FolderDrop"
                                  AutomationProperties.Name="{Binding Item.DisplayName}"
                                  AutomationProperties.HelpText="Open mail folder">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Item.DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Item.CountText}" FontWeight="SemiBold" Foreground="{DynamicResource BetterMailAccentBrush}" Margin="6,0,1,0" VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                        </TreeDataTemplate>
                      </TreeView.ItemTemplate>
                    </TreeView>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Border>

    <!-- Compact message list -->
    <Border x:Name="MessageListPane" Grid.Row="2" Grid.Column="2"
            Background="{DynamicResource BetterMailSurfaceBrush}"
            BorderBrush="{DynamicResource BetterMailDividerBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*">
        <Border Padding="18,16,14,14" BorderBrush="{DynamicResource BetterMailDividerBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding CurrentFolderName}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding CurrentItemCountText}" FontSize="11" Opacity="0.62" />
              <TextBlock Text="{Binding MailSelectionText}" FontSize="11" />
            </StackPanel>
            <Border Grid.Column="1" IsVisible="{Binding IsSearchResultsView}" Background="{DynamicResource BetterMailSelectionBrush}" CornerRadius="3" Padding="7,3" VerticalAlignment="Center" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding SearchResultSummary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                <Button Classes="command" Content="×" Padding="2,0" Command="{Binding ClearSearchResultsCommand}" AutomationProperties.Name="Clear mail search results" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <TextBlock Text="Loading messages…" IsVisible="{Binding IsLoadingMessages}"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" ZIndex="1" />
          <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}"
                   SelectionMode="Multiple"
                   IsVisible="{Binding IsMessageListView}"
                   Background="Transparent"
                   BorderThickness="0"
                   AutomationProperties.Name="Message list"
                   AutomationProperties.HelpText="Ctrl or Command click to select multiple messages; Shift click for a range; Ctrl or Command A selects loaded messages"
                   TabIndex="50"
                   PointerReleased="MessageListPointerReleased"
                   SelectionChanged="MessageSelectionChanged"
                   KeyDown="MessageListKeyDown">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BetterMailHoverBrush}" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BetterMailSelectionBrush}" />
              </Style>
              <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource BetterMailAccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
              </Style>
              <Style Selector="Border.quickActions">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="RenderTransform" Value="translate(160px, 0px)" />
                <Setter Property="Background" Value="{DynamicResource BetterMailSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BetterMailDividerBrush}" />
                <Setter Property="BorderThickness" Value="1,0,0,0" />
                <Setter Property="BoxShadow" Value="{DynamicResource BetterMailQuickActionShadow}" />
              </Style>
              <Style Selector="ListBoxItem:pointerover Border.quickActions, ListBoxItem:focus-within Border.quickActions">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
                <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
              </Style>
              <Style Selector="TextBlock.mailRowTitle.unread">
                <Setter Property="FontWeight" Value="SemiBold" />
              </Style>
              <Style Selector="Border.quickActions Button.command">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="15" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:MailMessage" x:CompileBindings="True">
                <Border Height="{ReflectionBinding $parent[Window].DataContext.MessageRowHeight}"
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource BetterMailDividerBrush}"
                        BorderThickness="0,0,0,1"
                        DoubleTapped="MessageRowDoubleTapped"
                        PointerPressed="MessageDragPointerPressed"
                        PointerMoved="MessageDragPointerMoved">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Reply" Click="MessageReplyClicked" AutomationProperties.Name="Reply to message" />
                      <MenuItem Header="Reply all" Click="MessageReplyAllClicked" AutomationProperties.Name="Reply all to message" />
                      <MenuItem Header="Forward" Click="MessageForwardClicked" AutomationProperties.Name="Forward message" />
                      <Separator />
                      <MenuItem Header="Archive" Click="MessageArchiveClicked" AutomationProperties.Name="Archive message" />
                      <MenuItem Header="Delete" Click="MessageDeleteClicked" AutomationProperties.Name="Delete message" />
                      <MenuItem Header="Junk" Click="MessageJunkClicked" AutomationProperties.Name="Mark message as junk" />
                      <MenuItem Header="Not junk" Click="MessageNotJunkClicked" AutomationProperties.Name="Mark message as not junk" />
                      <MenuItem Header="Move to folder" SubmenuOpened="MoveMenuOpened" AutomationProperties.Name="Move message to folder" />
                      <MenuItem Header="Flag or clear flag" Click="MessageFlagClicked" AutomationProperties.Name="Toggle message flag" />
                      <MenuItem Header="Pin or unpin" Click="MessagePinClicked" AutomationProperties.Name="Toggle message pin" />
                      <MenuItem Header="Mark read or unread" Click="MessageReadClicked" AutomationProperties.Name="Toggle message read state" />
                      <MenuItem Header="View message headers" Click="MessageHeadersClicked" AutomationProperties.Name="View message headers" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid ClipToBounds="True">
                    <Border Width="4" Background="{DynamicResource BetterMailAccentBrush}" IsVisible="{Binding IsUnread}" HorizontalAlignment="Left" />
                    <Grid Margin="{ReflectionBinding $parent[Window].DataContext.MessageRowMargin}" ColumnDefinitions="5,*,Auto" RowDefinitions="18,18,18" RowSpacing="1">

                    <Grid Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto">
                      <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0"
                              Background="{Binding MailboxColor}"
                              VerticalAlignment="Center"
                              IsVisible="{ReflectionBinding $parent[Window].DataContext.IsUnifiedInbox}" />
                      <TextBlock Grid.Column="1" Classes="mailRowTitle" Classes.unread="{Binding IsUnread}"
                                 Text="{Binding SenderDisplayName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                 Text="{Binding LocalReceivedAt, StringFormat='{}{0:MMM d, HH:mm}'}"
                                 FontSize="11" Opacity="0.62" />
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto">
                      <TextBlock Classes="mailRowTitle" Classes.unread="{Binding IsUnread}"
                                 Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="&#x1F4CE;" FontFamily="Segoe UI Symbol"
                                 IsVisible="{Binding HasAttachments}" Margin="7,0,0,0" Opacity="0.65"
                                 ToolTip.Tip="Has attachments" />
                      <TextBlock Grid.Column="2" Text="⚑" IsVisible="{Binding IsFlagged}" Margin="7,0,0,0" Foreground="#C75000" ToolTip.Tip="Flagged" />
                      <TextBlock Grid.Column="3" Text="&#x1F4CC;" IsVisible="{Binding IsPinned}" Margin="7,0,0,0" ToolTip.Tip="Pinned" />
                    </Grid>

                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding DisplayPreview}" TextTrimming="CharacterEllipsis" Opacity="0.62" FontSize="11" Margin="0,1,0,1" VerticalAlignment="Center" />
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Categories}" MaxWidth="150" Margin="6,0,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource BetterMailSelectionBrush}" CornerRadius="2" Padding="5,1" Margin="2,0"><TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource BetterMailAccentBrush}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                    </Grid>
                    <Border Classes="quickActions"
                            IsVisible="{ReflectionBinding $parent[Window].DataContext.HasMailQuickActions}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            ZIndex="2">
                      <Border.Transitions>
                        <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
                        </Transitions>
                      </Border.Transitions>
                      <ItemsControl ItemsSource="{ReflectionBinding $parent[Window].DataContext.MailQuickActions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="app:MailQuickActionOption">
                            <Grid Width="40" Height="{ReflectionBinding $parent[Window].DataContext.MessageRowHeight}">
                              <Button Classes="command"
                                      Content="{Binding Icon}"
                                      FontFamily="Segoe UI Symbol"
                                      IsVisible="{Binding IsStandard}"
                                      CommandParameter="{Binding $parent[ItemsControl].DataContext}"
                                      PointerPressed="QuickActionPressed"
                                      Click="QuickActionClicked"
                                      ToolTip.Tip="{Binding Label}"
                                      AutomationProperties.Name="{Binding Label}" />
                              <Button Classes="command"
                                      Content="{Binding Icon}"
                                      FontFamily="Segoe UI Symbol"
                                      IsVisible="{Binding IsMove}"
                                      CommandParameter="{Binding $parent[ItemsControl].DataContext}"
                                      PointerPressed="QuickActionPressed"
                                      ToolTip.Tip="{Binding Label}"
                                      AutomationProperties.Name="{Binding Label}">
                                <Button.Flyout>
                                  <Flyout>
                                    <ScrollViewer MaxHeight="420" MinWidth="230">
                                      <ItemsControl ItemsSource="{ReflectionBinding $parent[Window].DataContext.Folders}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="app:MailFolderItem">
                                            <Button Classes="command"
                                                    Content="{Binding DisplayName}"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{ReflectionBinding $parent[Window].DataContext.MoveToFolderCommand}"
                                                    CommandParameter="{Binding}" />
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </ScrollViewer>
                                  </Flyout>
                                </Button.Flyout>
                              </Button>
                              <Button Classes="command"
                                      Content="{Binding Icon}"
                                      FontFamily="Segoe UI Symbol"
                                      IsVisible="{Binding IsMore}"
                                      CommandParameter="{Binding $parent[ItemsControl].DataContext}"
                                      PointerPressed="QuickActionPressed"
                                      ToolTip.Tip="{Binding Label}"
                                      AutomationProperties.Name="{Binding Label}">
                                <Button.Flyout>
                                  <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel MinWidth="190">
                                      <Button Classes="command" Content="Reply all" HorizontalContentAlignment="Left" Click="MessageReplyAllClicked" />
                                      <Button Classes="command" Content="Reply" HorizontalContentAlignment="Left" Click="MessageReplyClicked" />
                                      <Button Classes="command" Content="Forward" HorizontalContentAlignment="Left" Click="MessageForwardClicked" />
                                      <Button Classes="command" Content="Archive" HorizontalContentAlignment="Left" Click="MessageArchiveClicked" />
                                      <Button Classes="command" Content="Delete" HorizontalContentAlignment="Left" Click="MessageDeleteClicked" />
                                      <Button Classes="command" Content="Move to folder" HorizontalContentAlignment="Left">
                                        <Button.Flyout>
                                          <Flyout>
                                            <ScrollViewer MaxHeight="420" MinWidth="230">
                                              <ItemsControl ItemsSource="{ReflectionBinding $parent[Window].DataContext.Folders}">
                                                <ItemsControl.ItemTemplate>
                                                  <DataTemplate x:DataType="app:MailFolderItem">
                                                    <Button Classes="command" Content="{Binding DisplayName}" HorizontalContentAlignment="Left"
                                                            Command="{ReflectionBinding $parent[Window].DataContext.MoveToFolderCommand}" CommandParameter="{Binding}" />
                                                  </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                              </ItemsControl>
                                            </ScrollViewer>
                                          </Flyout>
                                        </Button.Flyout>
                                      </Button>
                                      <Border Height="1" Background="{DynamicResource BetterMailDividerBrush}" Margin="4" />
                                      <Button Classes="command" Content="Junk" HorizontalContentAlignment="Left" Click="MessageJunkClicked" />
                                      <Button Classes="command" Content="{ReflectionBinding $parent[Window].DataContext.ToggleFlagText}" HorizontalContentAlignment="Left" Click="MessageFlagClicked" />
                                      <Button Classes="command" Content="{ReflectionBinding $parent[Window].DataContext.TogglePinText}" HorizontalContentAlignment="Left" Command="{ReflectionBinding $parent[Window].DataContext.TogglePinCommand}" />
                                      <Button Classes="command" Content="{ReflectionBinding $parent[Window].DataContext.ToggleReadText}" HorizontalContentAlignment="Left" Click="MessageReadClicked" />
                                      <Button Classes="command" Content="View headers" HorizontalContentAlignment="Left"
                                              Command="{ReflectionBinding $parent[Window].DataContext.ViewHeadersCommand}" />
                                    </StackPanel>
                                  </Flyout>
                                </Button.Flyout>
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Button x:Name="LoadOlderButton"
                  Content="Load older messages"
                  Command="{Binding LoadMoreMessagesCommand}"
                  IsVisible="False"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  ZIndex="4"
                  Margin="12"
                  Padding="14,6"
                  AutomationProperties.Name="Load older messages" />

          <ListBox ItemsSource="{Binding VisibleDrafts}"
                   Grid.RowSpan="2"
                   IsVisible="{Binding ShowDraftRows}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Background="Transparent"
                   BorderThickness="0"
                   AutomationProperties.Name="{Binding CurrentFolderName}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BetterMailHoverBrush}" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BetterMailSelectionBrush}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:LocalDraft">
                <Button Classes="searchResult"
                        Height="{Binding $parent[Window].DataContext.MessageRowHeight}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="14,4,9,5"
                        Command="{Binding $parent[Window].DataContext.OpenDraftCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding DisplaySubject}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="18,18,18" RowSpacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" Foreground="{DynamicResource BetterMailAccentBrush}" />
                      <Border Background="#22D13438" CornerRadius="2" Padding="5,1" IsVisible="{Binding HasSyncIssue}">
                        <TextBlock Text="{Binding SyncStatusText}" Foreground="#D13438" FontSize="10" FontWeight="SemiBold" />
                      </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding LocalUpdatedAt, StringFormat='{}{0:MMM d, HH:mm}'}" FontSize="11" Opacity="0.62" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DisplaySubject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding DetailText}" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis" Margin="0,1,0,1" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ListBox ItemsSource="{Binding BusyActions}" IsVisible="{Binding IsOutboxView}"
                   Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Pending mail actions">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:MailAction">
                <Border Padding="14,7,9,7" HorizontalAlignment="Stretch" Background="Transparent"
                        BorderBrush="{DynamicResource BetterMailDividerBrush}" BorderThickness="0,0,0,1"
                        ToolTip.Tip="{Binding Error}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="3">
                    <TextBlock Text="{Binding ActionText}" Foreground="{DynamicResource BetterMailAccentBrush}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding LocalCreatedAt, StringFormat='{}{0:MMM d, HH:mm}'}" FontSize="11" Opacity="0.62" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DisplaySubject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{Binding MailboxAddress}" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Opacity="0.62" Margin="8,0,0,0" />
                    <Button Grid.Row="3" Grid.Column="1" Content="Cancel" HorizontalAlignment="Right"
                            Command="{Binding $parent[Window].DataContext.CancelBusyActionCommand}"
                            CommandParameter="{Binding}" IsEnabled="{Binding CanCancel}"
                            ToolTip.Tip="Cancel a waiting action. Actions already executing cannot be recalled." />
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="6" IsVisible="{Binding NeedsSendReview}">
                      <TextBlock Text="Check Sent in your provider before retrying. This message will not be sent again automatically." TextWrapping="Wrap" FontSize="12" />
                      <WrapPanel>
                        <Button Content="I found it in Sent" Margin="0,0,8,0" Command="{Binding $parent[Window].DataContext.ConfirmSentCommand}" CommandParameter="{Binding}" />
                        <Button Content="Return to drafts" Command="{Binding $parent[Window].DataContext.ReturnUnconfirmedSendCommand}" CommandParameter="{Binding}" />
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280" Spacing="10">
            <TextBlock Text="No mail here" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="This folder is empty." TextAlignment="Center" Opacity="0.65" />
          </StackPanel>
          <StackPanel IsVisible="{Binding ShowDraftEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="{Binding DraftEmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding DraftEmptyDescription}" Opacity="0.62" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Reading pane -->
    <Grid x:Name="ReadingPane"
          Grid.Row="2"
          Grid.Column="3"
          RowDefinitions="Auto,*"
          Background="{DynamicResource BetterMailSurfaceBrush}">
      <Button x:Name="PhoneBack"
              Classes="command"
              Content="‹"
              FontSize="22"
              Padding="7,0"
              Margin="8,5"
              HorizontalAlignment="Left"
              Click="PhoneBackClicked"
              IsVisible="False"
              ToolTip.Tip="Back to messages"
              AutomationProperties.Name="Back to messages" />

      <app:ConversationThreadView Grid.Row="1"
                                  DataContext="{Binding ConversationThread}"
                                  IsVisible="{Binding $parent[Window].DataContext.ShowMessageBody}" />
      <StackPanel Grid.Row="1"
                  IsVisible="{Binding HasNoSelectedMessage}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <TextBlock Text="✉" FontSize="28" Opacity="0.35" HorizontalAlignment="Center" />
        <TextBlock Text="Select a message to read" FontSize="16" Opacity="0.55" />
      </StackPanel>
    </Grid>

    <GridSplitter x:Name="FolderSplitter" Grid.Row="2"
                  Grid.Column="2"
                  Width="5"
                  HorizontalAlignment="Left"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndCurrent"
                  Background="Transparent"
                  ZIndex="10" />
    <GridSplitter x:Name="ReadingSplitter" Grid.Row="2"
                  Grid.Column="3"
                  Width="5"
                  HorizontalAlignment="Left"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndCurrent"
                  Background="Transparent"
                  ZIndex="10" />

    <!-- Microsoft 365 workspace modules. -->
    <Border x:Name="WorkspaceSurface" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="3"
            Background="{DynamicResource BetterMailSurfaceBrush}"
            IsVisible="{Binding ShowWorkspaceSurface}">
      <Grid RowDefinitions="Auto,*">
        <Border Padding="22,12" BorderBrush="{DynamicResource BetterMailDividerBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding IsGenericWorkspaceModule}">
          <Grid x:Name="ModuleHeader" ColumnDefinitions="*,320,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
            <TextBlock Text="{Binding ActiveModule}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox x:Name="ModuleSearch" Grid.Column="1"
                     Classes="moduleSearch"
                     Text="{Binding ModuleSearchText}"
                     PlaceholderText="Search this module"
                     IsVisible="{Binding ShowWorkspaceSearch}"
                     AutomationProperties.Name="Search this module" />
            <Button x:Name="ModuleRefresh" Grid.Column="2"
                    Classes="command"
                    Content="Search"
                    Command="{Binding SearchWorkspaceCommand}"
                    IsVisible="{Binding ShowWorkspaceSearch}"
                    AutomationProperties.Name="Search this module" />
            <Button Grid.Column="2"
                    Classes="command"
                    Content="Refresh"
                    Command="{Binding RefreshWorkspaceCommand}"
                    IsVisible="{Binding ShowWorkspaceRefresh}"
                    AutomationProperties.Name="Refresh current module" />
          </Grid>
        </Border>

        <ContentControl Grid.RowSpan="2" Content="{Binding ActiveWorkspace}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="app:CalendarWorkspaceViewModel">
              <app:CalendarWorkspaceView />
            </DataTemplate>
            <DataTemplate DataType="app:NotesWorkspaceViewModel">
              <app:NotesWorkspaceView />
            </DataTemplate>
            <DataTemplate DataType="app:DriveWorkspaceViewModel">
              <app:DriveWorkspaceView />
            </DataTemplate>
            <DataTemplate DataType="app:TasksWorkspaceViewModel">
              <app:TasksWorkspaceView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <Grid Grid.Row="1" IsVisible="{Binding IsGenericWorkspaceModule}">
          <ProgressBar IsIndeterminate="True"
                       Width="260"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsWorkspaceLoading}" />

          <Grid IsVisible="{Binding IsContactsModule}" RowDefinitions="Auto,Auto,*" Margin="18,10">
            <Button Classes="primary" Content="New contact" Command="{Binding NewContactCommand}"
                    HorizontalAlignment="Left" Margin="0,0,0,8"
                    AutomationProperties.Name="Create a contact" />
            <Border Background="#18D9493D"
                    BorderBrush="#55D9493D"
                    BorderThickness="1"
                    Padding="10,7"
                    Margin="0,0,0,8"
                    Grid.Row="1" IsVisible="{Binding HasPeopleErrors}">
              <TextBlock Text="{Binding PeopleErrorText}" TextWrapping="Wrap" Foreground="#B3261E" />
            </Border>
            <ListBox x:Name="PeopleCards" Grid.Row="2"
                     ItemsSource="{Binding People}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="People across linked accounts">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:PersonEntry" x:CompileBindings="True">
                  <Border Padding="8,4" Margin="0,0,0,1" Background="{DynamicResource BetterMailSurfaceBrush}"
                          BorderBrush="{DynamicResource BetterMailDividerBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8" MinHeight="38">
                      <app:AsyncImage Width="26" Height="26" Request="{Binding Avatar}" AllowLoading="{ReflectionBinding $parent[Window].DataContext.ContactImagesEnabled}" VerticalAlignment="Center" />
                      <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="12" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding ProvenanceText}">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding EmailText}" Foreground="{DynamicResource BetterMailMutedBrush}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="command" Content="New mail" Click="ComposeContactClicked" AutomationProperties.Name="Start a mail to contact" />
                        <Button Classes="command" Content="•••" AutomationProperties.Name="Contact actions">
                          <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="4" MinWidth="160">
                              <TextBlock Text="{Binding ProvenanceText}" TextWrapping="Wrap" MaxWidth="240" Margin="8" />
                              <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource BetterMailMutedBrush}" Margin="8" />
                              <Button Classes="command" Content="View mail" Click="ViewContactMailClicked" />
                              <Button Classes="command" Content="Copy email" CommandParameter="{Binding EmailText}" Click="CopyContactTextClicked" />
                              <Button Classes="command" Content="Edit" IsVisible="{Binding IsSaved}" Click="EditPersonClicked" />
                              <Button Classes="command" Content="Delete" IsVisible="{Binding IsSaved}" Click="DeletePersonClicked" />
                            </StackPanel>
                          </Flyout></Button.Flyout>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.RowSpan="3" IsVisible="{Binding IsContactPaneOpen}" ZIndex="20">
              <Button Background="#99000000" BorderThickness="0" CornerRadius="0"
                      Command="{Binding CancelEditContactCommand}"
                      AutomationProperties.Name="Close contact editor backdrop" />
              <Border Width="460" MaxWidth="460" Margin="12"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch"
                      Background="{DynamicResource BetterMailSurfaceBrush}"
                      BorderBrush="{DynamicResource BetterMailDividerBrush}" BorderThickness="1">
                <StackPanel Margin="20" Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ContactEditorTitle}" FontSize="22" FontWeight="SemiBold"
                               IsVisible="{Binding IsContactEditorOpen}" />
                    <TextBlock Text="Delete contact" FontSize="22" FontWeight="SemiBold"
                               IsVisible="{Binding IsConfirmingContactDelete}" />
                    <Button Grid.Column="1" Classes="command" Content="Close"
                            Command="{Binding CancelEditContactCommand}" AutomationProperties.Name="Close contact pane" />
                  </Grid>
                  <StackPanel Spacing="8" IsVisible="{Binding IsContactEditorOpen}">
                    <TextBlock Text="Account" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding ContactOwners}" SelectedItem="{Binding SelectedContactOwner}"
                              IsEnabled="{Binding IsCreatingContact}"
                              AutomationProperties.Name="Contact account or shared mailbox">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="app:ContactOwnerOption">
                          <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Name" FontWeight="SemiBold" />
                    <TextBox Text="{Binding ContactName}" PlaceholderText="Display name" AutomationProperties.Name="Contact display name" />
                    <TextBlock Text="Email addresses" FontWeight="SemiBold" />
                    <TextBox Text="{Binding ContactEmails}" PlaceholderText="Email addresses separated by semicolons" AutomationProperties.Name="Contact email addresses" />
                    <Button Classes="primary" Content="Save" Command="{Binding SaveContactCommand}"
                            HorizontalAlignment="Right" AutomationProperties.Name="Save contact" />
                  </StackPanel>
                  <StackPanel Spacing="12" IsVisible="{Binding IsConfirmingContactDelete}">
                    <TextBlock Text="{Binding ContactDeleteText}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Button Content="Delete" Command="{Binding ConfirmDeleteContactCommand}"
                              Background="#D13438" Foreground="White" />
                      <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelDeleteContactCommand}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <StackPanel IsVisible="{Binding IsWorkspaceEmpty}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="6">
            <TextBlock Text="Nothing to show" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Try refreshing or changing your search." Opacity="0.62" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Settings is a full-window special surface. -->
    <Border x:Name="SettingsSurface" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="4"
            Background="{DynamicResource BetterMailSurfaceBrush}"
            IsVisible="{Binding IsSettingsOpen}">
      <app:SettingsView />
    </Border>

    <Border x:Name="FullAppLoader"
            Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="4"
            Background="{DynamicResource BetterMailSurfaceBrush}"
            IsVisible="{Binding ShowFullScreenLoader}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <Image Source="/Assets/BetterMail.png" Width="48" Height="48" HorizontalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Width="220" />
        <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" />
        <Button Classes="command"
                Content="Cancel sign-in"
                Command="{Binding CancelSignInCommand}"
                IsVisible="{Binding CanCancelSignIn}"
                Background="{DynamicResource BetterMailNeutralItemBrush}"
                BorderBrush="{DynamicResource BetterMailDividerBrush}"
                BorderThickness="1"
                Opacity="0.84"
                HorizontalAlignment="Center"
                AutomationProperties.Name="Cancel sign-in" />
      </StackPanel>
    </Border>

    <Border x:Name="ErrorToast" Grid.Row="2" Grid.Column="3" Background="#D9493D" CornerRadius="3" Padding="11,7" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="520" IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
        <TextBlock Text="{Binding Error}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="command" Content="Copy" Foreground="White" Click="CopyErrorClicked" AutomationProperties.Name="Copy error" />
        <Button Grid.Column="2" Classes="command" Content="×" Foreground="White" Click="CloseErrorClicked" AutomationProperties.Name="Close error" />
      </Grid>
    </Border>

    <Border Grid.RowSpan="3" Grid.ColumnSpan="4" Background="#B3000000" IsVisible="{Binding ShowOnboarding}">
      <Border MaxWidth="480" Margin="16" Padding="32" CornerRadius="6" Background="{DynamicResource BetterMailSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <Image Source="/Assets/BetterMail.png" Width="48" Height="48" HorizontalAlignment="Left" />
          <TextBlock Text="Welcome to BetterMail" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Connect Microsoft 365 or Google Workspace to build your encrypted local inbox." FontSize="15" TextWrapping="Wrap" Opacity="0.74" />
          <TextBlock Text="Your credentials stay with your provider. BetterMail protects local tokens and cached mail with encrypted storage." TextWrapping="Wrap" Opacity="0.62" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button Classes="primary" Content="Connect Microsoft 365" Command="{Binding ConnectCommand}" />
            <Button Classes="primary" Content="Connect Google Workspace" Command="{Binding ConnectGoogleCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding Status}" Opacity="0.62" />
          <Border Background="#D9493D" CornerRadius="3" Padding="9" IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding Error}" Foreground="White" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
