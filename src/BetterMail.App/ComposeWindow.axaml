<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:BetterMail.App"
        xmlns:core="using:BetterMail.Core"
        x:Class="BetterMail.App.ComposeWindow"
        Title="New message" Icon="/Assets/BetterMail.ico"
        Width="820" Height="720" MinWidth="560" MinHeight="500"
        KeyDown="ComposeWindowKeyDown" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBox.composeHeader, ComboBox.composeHeader">
      <Setter Property="BorderBrush" Value="{DynamicResource BetterMailDividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Border.recipientField">
      <Setter Property="BorderBrush" Value="{DynamicResource BetterMailDividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="TextBox.composeHeader:focus-within, ComboBox.composeHeader:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource BetterMailAccentBrush}" />
    </Style>
    <Style Selector="Border.recipientField:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource BetterMailAccentBrush}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="18">
    <Grid ColumnDefinitions="80,*" Margin="0,0,0,10" IsEnabled="{Binding CanChangeAttachments}">
      <TextBlock Text="From" VerticalAlignment="Center" Opacity="0.7" />
      <ComboBox Grid.Column="1" Classes="composeHeader" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                ItemsSource="{Binding Senders}" SelectedItem="{Binding SelectedSender}" AutomationProperties.Name="From">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecipientFields}" IsEnabled="{Binding CanChangeAttachments}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="80,*" Margin="0,0,0,8">
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Opacity="0.7" />
            <Border Grid.Column="1" Classes="recipientField" PointerPressed="RecipientFieldPressed">
              <Grid>
                <DockPanel LastChildFill="True">
                  <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tokens}" Margin="5,0,5,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource BetterMailSelectionBrush}" CornerRadius="10" Padding="7,3" Margin="0,4,4,0"
                                MaxWidth="{Binding $parent[ItemsControl].Bounds.Width}">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="×" Padding="2,0" Background="Transparent" BorderThickness="0"
                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveTokenCommand}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="Remove recipient" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox x:Name="RecipientQuery" Text="{Binding Query}" MinHeight="34" BorderThickness="0"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                           Padding="9,5" Background="Transparent" PlaceholderText="Type a name or address"
                           AutomationProperties.Name="{Binding Label}"
                           GotFocus="RecipientQueryGotFocus" KeyDown="RecipientQueryKeyDown" />
                </DockPanel>
                <Popup IsOpen="{Binding IsSearchOpen}" PlacementTarget="{Binding #RecipientQuery}" Placement="BottomEdgeAlignedLeft"
                       IsLightDismissEnabled="True">
                  <Border Width="420" MaxHeight="280" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                          BorderBrush="{DynamicResource BetterMailDividerBrush}" BorderThickness="1" BoxShadow="0 6 18 0 #44000000">
                    <ListBox ItemsSource="{Binding Suggestions}" Background="Transparent" BorderThickness="0">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Button Classes="command" HorizontalContentAlignment="Stretch" Padding="10,7"
                                  Command="{Binding $parent[ListBox].DataContext.AddSuggestionCommand}" CommandParameter="{Binding}">
                            <StackPanel>
                              <TextBlock Text="{Binding PrimaryText}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding SecondaryText}" FontSize="11" Opacity="0.65" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                </Popup>
              </Grid>
            </Border>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Grid.Row="2" ColumnDefinitions="80,*" Margin="0,0,0,10" IsEnabled="{Binding CanChangeAttachments}">
      <TextBlock Text="Subject" VerticalAlignment="Center" Opacity="0.7" />
      <TextBox Grid.Column="1" Classes="composeHeader" Text="{Binding Subject}" VerticalContentAlignment="Center" AutomationProperties.Name="Subject" />
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,10" IsEnabled="{Binding CanChangeAttachments}">
      <Button Content="Attach file" Click="AttachFileClicked" Padding="12,7" />
      <Button Grid.Column="1" Content="Attach from Drive" Click="AttachDriveClicked" Margin="6,0,0,0" Padding="12,7" />
      <Button Grid.Column="2" Content="Mail options" HorizontalAlignment="Right" Padding="12,7">
        <Button.Flyout>
          <Flyout>
            <StackPanel MinWidth="240" Spacing="10">
              <TextBlock Text="Importance" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding ImportanceLevels}" SelectedItem="{Binding Importance}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="Message importance" />
              <CheckBox Content="Flag for follow-up" IsChecked="{Binding IsFlagged}" IsEnabled="{Binding SupportsFollowUpFlag}"
                        ToolTip.Tip="Follow-up flags are available for Microsoft 365 accounts." />
              <CheckBox Content="Request read receipt" IsChecked="{Binding RequestReadReceipt}" IsEnabled="{Binding SupportsReceipts}"
                        ToolTip.Tip="Receipt requests are available for Microsoft 365 accounts." />
              <CheckBox Content="Request delivery receipt" IsChecked="{Binding RequestDeliveryReceipt}" IsEnabled="{Binding SupportsReceipts}"
                        ToolTip.Tip="Receipt requests are available for Microsoft 365 accounts." />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Attachments}" Margin="0,6,0,0">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:DraftAttachment">
            <Border BorderBrush="{DynamicResource BetterMailDividerBrush}" BorderThickness="1" CornerRadius="2" Padding="7,4" Margin="0,0,6,2">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{Binding Name}" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SizeText}" Opacity="0.6" />
                <Button Content="x" Padding="3,0" Background="Transparent"
                        Command="{Binding $parent[Window].DataContext.RemoveAttachmentCommand}" CommandParameter="{Binding}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <app:RichHtmlEditor x:Name="Composer" Grid.Row="4"
                        Html="{Binding Body, Mode=TwoWay}"
                        IsReadOnly="{Binding IsSending}"
                        Placeholder="Write something useful…"
                        AutomationProperties.Name="Rich text message body" />

    <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,14,0,0">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Above 20 MiB total: Drive link, readable by anyone with the link; expires within one year." TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
        <TextBlock Text="Uploading attachment…" IsVisible="{Binding IsUploadingAttachment}" FontSize="11" />
        <TextBlock Text="{Binding DraftStatus}" FontSize="11" Opacity="0.6" />
      </StackPanel>
      <Button Grid.Column="1" Classes="command" Content="Delete draft" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanChangeAttachments}" />
      <Button Grid.Column="2" Content="Cancel" Click="CancelClicked" Margin="8,0" IsEnabled="{Binding CanChangeAttachments}" />
      <Button Grid.Column="3" Classes="primary" Click="SendClicked"
              IsEnabled="{Binding CanChangeAttachments}" AutomationProperties.Name="Send message">
        <Grid MinWidth="52">
          <TextBlock Text="Send" HorizontalAlignment="Center" IsVisible="{Binding !IsSending}" />
          <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" IsVisible="{Binding IsSending}">
            <ProgressBar Width="24" Height="3" IsIndeterminate="True" VerticalAlignment="Center" />
            <TextBlock Text="Queueing..." />
          </StackPanel>
        </Grid>
      </Button>
    </Grid>

    <Border Grid.RowSpan="6" ZIndex="20" Background="#D9493D" CornerRadius="3" Padding="11,7"
            Margin="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="520"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
        <TextBlock Text="{Binding Error}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="command" Content="Copy" Foreground="White"
                Click="CopyErrorClicked" AutomationProperties.Name="Copy error" />
        <Button Grid.Column="2" Classes="command" Content="&#x00D7;" Foreground="White"
                Click="CloseErrorClicked" AutomationProperties.Name="Close error" />
      </Grid>
    </Border>
  </Grid>
</Window>
